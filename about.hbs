<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Third-party licences</title>
<style>
body { font-family: sans-serif; max-width: 60em; margin: 2em auto; padding: 0 1em; }
pre { white-space: pre-wrap; background: #f4f4f4; padding: 1em; }
li { margin: 0.2em 0; }
</style>
</head>
<body>
<h1>Third-party licences</h1>
<p>This program includes the following crates. Each licence below lists the crates it applies to.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
<li>{{name}}, {{count}} crates:{{#each indices}} <a href="#licence-{{this}}">#{{this}}</a>{{/each}}</li>
{{/each}}
</ul>
<h2>Licences</h2>
{{#each licenses}}
<h3 id="licence-{{@index}}">#{{@index}} {{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}
<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
