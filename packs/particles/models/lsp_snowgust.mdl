# Landscaper particle pack: Snow gusts. Written from scratch; derived from the stock fx_snow's flakes, blown sideways.
newmodel lsp_snowgust
setsupermodel lsp_snowgust NULL
classification Character
setanimationscale 1
beginmodelgeom lsp_snowgust
node dummy lsp_snowgust
  parent NULL
endnode
node emitter gust
  parent lsp_snowgust
  position 0 0 0.4
  orientation 0 1 0 1.5708
  update Fountain
  render Normal
  blend Normal
  texture fxpa_dot01
  xgrid 1
  ygrid 1
  spawntype 0
  twosidedtex 0
  loop 0
  renderorder 0
  deadspace 0
  blastRadius 0
  blastLength 0
  p2p 0
  p2p_sel 0
  affectedByWind 1
  m_isTinted 0
  bounce 0
  random 0
  inherit 0
  inheritvel 0
  inherit_local 0
  splat 0
  inherit_part 0
  birthrate 28
  lifeExp 2
  colorStart 1 1 1
  colorEnd 0.95 0.97 1
  alphaStart 0.9
  alphaEnd 0
  sizeStart 0.1
  sizeEnd 0.06
  velocity 4
  randvel 1.2
  spread 0.35
  grav 0
  drag 0
  particleRot 0
  mass 0
  fps 0
  frameStart 0
  frameEnd 0
  blurlength 10
  sizeStart_y 0
  sizeEnd_y 0
  bounce_co 0
  threshold 0
  combinetime 0
  lightningDelay 0
  lightningRadius 0
  lightningScale 0
  p2p_bezier2 0
  p2p_bezier3 0
  xsize 60
  ysize 600
endnode
endmodelgeom lsp_snowgust

newanim default lsp_snowgust
  length 0.0333
  transtime 0.25
  animroot lsp_snowgust
  node dummy lsp_snowgust
    parent NULL
  endnode
  node emitter gust
    parent lsp_snowgust
    birthratekey 1
      0 28
    endlist
  endnode
doneanim default lsp_snowgust

newanim on lsp_snowgust
  length 0.0333
  transtime 0.25
  animroot lsp_snowgust
  node dummy lsp_snowgust
    parent NULL
  endnode
  node emitter gust
    parent lsp_snowgust
    birthratekey 1
      0 28
    endlist
  endnode
doneanim on lsp_snowgust

newanim off lsp_snowgust
  length 0.0333
  transtime 0.25
  animroot lsp_snowgust
  node dummy lsp_snowgust
    parent NULL
  endnode
  node emitter gust
    parent lsp_snowgust
    birthratekey 1
      0 0
    endlist
  endnode
doneanim off lsp_snowgust

donemodel lsp_snowgust
