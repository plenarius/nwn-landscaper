# Landscaper particle pack: Water mist. Written from scratch; derived from the stock tnp_gmist and dag_fog_med.
newmodel lsp_mist
setsupermodel lsp_mist NULL
classification Character
setanimationscale 1
beginmodelgeom lsp_mist
node dummy lsp_mist
  parent NULL
endnode
node emitter mist
  parent lsp_mist
  position 0 0 0.3
  update Fountain
  render Billboard_to_World_Z
  blend Normal
  texture fxpa_mist
  xgrid 4
  ygrid 4
  spawntype 0
  twosidedtex 0
  loop 0
  renderorder 0
  deadspace 0
  blastRadius 0
  blastLength 0
  p2p 0
  p2p_sel 0
  affectedByWind 0
  m_isTinted 0
  bounce 0
  random 1
  inherit 0
  inheritvel 0
  inherit_local 0
  splat 0
  inherit_part 0
  birthrate 1.5
  lifeExp 12
  colorStart 0.92 0.94 0.96
  colorEnd 0.85 0.87 0.9
  alphaStart 0.35
  alphaEnd 0
  sizeStart 3
  sizeEnd 7
  velocity 0.1
  randvel 0.05
  spread 0.3
  grav 0
  drag 0
  particleRot 0.05
  mass 0
  fps 0
  frameStart 0
  frameEnd 15
  blurlength 10
  sizeStart_y 0
  sizeEnd_y 0
  bounce_co 0
  threshold 0
  combinetime 0
  lightningDelay 0
  lightningRadius 0
  lightningScale 0
  p2p_bezier2 0
  p2p_bezier3 0
  xsize 800
  ysize 800
endnode
endmodelgeom lsp_mist

newanim default lsp_mist
  length 0.0333
  transtime 0.25
  animroot lsp_mist
  node dummy lsp_mist
    parent NULL
  endnode
  node emitter mist
    parent lsp_mist
    birthratekey 1
      0 1.5
    endlist
  endnode
doneanim default lsp_mist

newanim on lsp_mist
  length 0.0333
  transtime 0.25
  animroot lsp_mist
  node dummy lsp_mist
    parent NULL
  endnode
  node emitter mist
    parent lsp_mist
    birthratekey 1
      0 1.5
    endlist
  endnode
doneanim on lsp_mist

newanim off lsp_mist
  length 0.0333
  transtime 0.25
  animroot lsp_mist
  node dummy lsp_mist
    parent NULL
  endnode
  node emitter mist
    parent lsp_mist
    birthratekey 1
      0 0
    endlist
  endnode
doneanim off lsp_mist

donemodel lsp_mist
