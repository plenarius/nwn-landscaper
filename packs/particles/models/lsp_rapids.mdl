# Landscaper particle pack: Rapids spray. Written from scratch; derived from the stock plc_j02's small fountain.
newmodel lsp_rapids
setsupermodel lsp_rapids NULL
classification Character
setanimationscale 1
beginmodelgeom lsp_rapids
node dummy lsp_rapids
  parent NULL
endnode
node emitter spray
  parent lsp_rapids
  position 0 0 0.05
  update Fountain
  render Motion_Blur
  blend Lighten
  texture fxpa_splash
  xgrid 1
  ygrid 1
  spawntype 0
  twosidedtex 0
  loop 0
  renderorder 0
  deadspace 0
  blastRadius 0
  blastLength 0
  p2p 0
  p2p_sel 0
  affectedByWind 0
  m_isTinted 0
  bounce 0
  random 0
  inherit 0
  inheritvel 0
  inherit_local 0
  splat 0
  inherit_part 0
  birthrate 6
  lifeExp 1
  colorStart 0.9 0.95 1
  colorEnd 0.7 0.8 0.9
  alphaStart 0.8
  alphaEnd 0
  sizeStart 0.15
  sizeEnd 0.45
  velocity 1.6
  randvel 0.6
  spread 0.9
  grav 5
  drag 0
  particleRot 0
  mass 0
  fps 0
  frameStart 0
  frameEnd 0
  blurlength 10
  sizeStart_y 0
  sizeEnd_y 0
  bounce_co 0
  threshold 0
  combinetime 0
  lightningDelay 0
  lightningRadius 0
  lightningScale 0
  p2p_bezier2 0
  p2p_bezier3 0
  xsize 150
  ysize 80
endnode
endmodelgeom lsp_rapids

newanim default lsp_rapids
  length 0.0333
  transtime 0.25
  animroot lsp_rapids
  node dummy lsp_rapids
    parent NULL
  endnode
  node emitter spray
    parent lsp_rapids
    birthratekey 1
      0 6
    endlist
  endnode
doneanim default lsp_rapids

newanim on lsp_rapids
  length 0.0333
  transtime 0.25
  animroot lsp_rapids
  node dummy lsp_rapids
    parent NULL
  endnode
  node emitter spray
    parent lsp_rapids
    birthratekey 1
      0 6
    endlist
  endnode
doneanim on lsp_rapids

newanim off lsp_rapids
  length 0.0333
  transtime 0.25
  animroot lsp_rapids
  node dummy lsp_rapids
    parent NULL
  endnode
  node emitter spray
    parent lsp_rapids
    birthratekey 1
      0 0
    endlist
  endnode
doneanim off lsp_rapids

donemodel lsp_rapids
