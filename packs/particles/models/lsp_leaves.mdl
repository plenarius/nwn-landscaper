# Landscaper particle pack: Falling leaves. Written from scratch; derived from the stock fx_leaf.
newmodel lsp_leaves
setsupermodel lsp_leaves NULL
classification Character
setanimationscale 1
beginmodelgeom lsp_leaves
node dummy lsp_leaves
  parent NULL
endnode
node emitter leaves
  parent lsp_leaves
  position 0 0 4
  update Fountain
  render Normal
  blend Normal
  texture fxpa_leaf
  xgrid 4
  ygrid 4
  spawntype 0
  twosidedtex 0
  loop 0
  renderorder 0
  deadspace 0
  blastRadius 0
  blastLength 0
  p2p 0
  p2p_sel 0
  affectedByWind 1
  m_isTinted 0
  bounce 0
  random 1
  inherit 0
  inheritvel 0
  inherit_local 0
  splat 0
  inherit_part 0
  birthrate 1
  lifeExp 4
  colorStart 1 1 1
  colorEnd 1 1 1
  alphaStart 1
  alphaEnd 0.6
  sizeStart 0.8
  sizeEnd 0.8
  velocity 0.2
  randvel 0.3
  spread 3.14
  grav 0.75
  drag 0
  particleRot 0.4
  mass 0
  fps 0
  frameStart 0
  frameEnd 15
  blurlength 10
  sizeStart_y 0
  sizeEnd_y 0
  bounce_co 0
  threshold 0
  combinetime 0
  lightningDelay 0
  lightningRadius 0
  lightningScale 0
  p2p_bezier2 0
  p2p_bezier3 0
  xsize 400
  ysize 400
endnode
endmodelgeom lsp_leaves

newanim default lsp_leaves
  length 0.0333
  transtime 0.25
  animroot lsp_leaves
  node dummy lsp_leaves
    parent NULL
  endnode
  node emitter leaves
    parent lsp_leaves
    birthratekey 1
      0 1
    endlist
  endnode
doneanim default lsp_leaves

newanim on lsp_leaves
  length 0.0333
  transtime 0.25
  animroot lsp_leaves
  node dummy lsp_leaves
    parent NULL
  endnode
  node emitter leaves
    parent lsp_leaves
    birthratekey 1
      0 1
    endlist
  endnode
doneanim on lsp_leaves

newanim off lsp_leaves
  length 0.0333
  transtime 0.25
  animroot lsp_leaves
  node dummy lsp_leaves
    parent NULL
  endnode
  node emitter leaves
    parent lsp_leaves
    birthratekey 1
      0 0
    endlist
  endnode
doneanim off lsp_leaves

donemodel lsp_leaves
