SITE_ADDRESS=landscaper.example.com
# people who may do everything (user names from the Caddyfile)
LANDSCAPER_ADMIN_USERS=alice
# required: a long random string (16 characters or more), e.g. `openssl rand -hex 24`;
# the Landscaper doesn't start without one
LANDSCAPER_PROXY_SECRET=
LANDSCAPER_PROJECT=My Module
NWN_GAME_DIR=/path/to/Neverwinter Nights
NWN_HOME_DIR=/path/to/your/nwn-user-folder
