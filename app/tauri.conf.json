{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NWN Landscaper",
  "identifier": "io.github.plenarius.nwnlandscaper",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "plenarius",
    "homepage": "https://github.com/plenarius/nwn-landscaper",
    "license": "GPL-3.0-or-later",
    "category": "DeveloperTool",
    "longDescription": "Paint terrain, get a Neverwinter Nights area with its own generated tileset. Needs Neverwinter Nights: Enhanced Edition.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
